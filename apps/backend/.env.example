PORT=3000
NODE_ENV=production

# Copia la cadena del pooler de Supabase (Transaction o Session pooler).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres
DATABASE_SSL=true

# Auth > API en Supabase. La publishable/anon key si puede usarse en el backend.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME

# Genera el par una sola vez con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tu-dominio.com

# Separa los dominios publicos de tienda y panel con coma.
CORS_ORIGINS=https://tienda.example.com,https://admin.example.com

# Se conserva para las sesiones actuales del panel administrativo.
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Datos mostrados al dueño de la tienda para pagar la activación.
BANK_NAME=
BANK_ACCOUNT=
BANK_BENEFICIARY=
